+int G_TffaTeams(void) {
+    return level.gametype == GT_TEAM ? ST_TffaCount(g_tffaTeams.integer) : 2;
+}
+
+qboolean G_TffaHasRoom(int team, int ignoreClient) {
+    if (level.gametype != GT_TEAM || !g_tffaTeamSize.integer) return qtrue;
+    return TeamCount(ignoreClient, (team_t)team) < Com_Clampi(2, 4, g_tffaTeamSize.integer);
+}
+
+team_t G_TffaNamedTeam(const char *name) {
+    if (name && *name) {
+        for (int slot = 0; slot < ST_TFFA_MAX_TEAMS; ++slot) {
+            team_t team = (team_t)ST_TffaTeamAt(slot);
+            if (!Q_stricmp(name, ST_TffaName(team))) return team;
+        }
+    }
+    return TEAM_FREE;
+}
