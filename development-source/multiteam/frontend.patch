+static int STP_TeamOrder(const STPBoard *board, int *teams) {
+ int count=ST_TffaCount(board->tffaCount);
+ for(int slot=0;slot<count;++slot) {
+  int team=ST_TffaTeamAt(slot), pos=slot;
+  int score=board->tffaCount>2?board->tffaScores[team]:(team==1?board->red:board->blue);
+  while(board->mode==6 && pos>0) {
+   int prev=teams[pos-1];
+   int other=board->tffaCount>2?board->tffaScores[prev]:(prev==1?board->red:board->blue);
+   if(other>=score)break;
+   teams[pos]=prev;
+   --pos;
+  }
+  teams[pos]=team;
+ }
+ return count;
+}
