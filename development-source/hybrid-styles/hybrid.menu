// @PAGE@ is substituted for each independent main/connected route.
menuDef {
 name @PAGE@
 fullScreen 1 rect 0 0 640 480 visible 1
 focusColor 1 1 1 1
 onESC { uiScript stHybridCancel; }
 itemDef { name arena rect 0 0 640 480 style 3 background "ui/assets/sabertrials/arena.tga" forecolor 1 1 1 1 visible 1 decoration }
 itemDef { name shade rect 0 0 640 480 style 1 backcolor .004 .014 .025 .93 visible 1 decoration }
 itemDef { name title text "SABER TRIALS / COMBAT STYLES" rect 28 20 584 32 font 2 textscale .84 forecolor .30 .78 1 1 visible 1 decoration }
 itemDef { name divider rect 28 61 584 1 style 1 backcolor .20 .55 .70 .65 visible 1 decoration }
 itemDef { name caption text "SINGLE SABER / CHOOSE THREE" rect 48 88 544 22 font 2 textscale .66 forecolor .55 .72 .83 1 visible 1 decoration }
 itemDef { name instructions text "Pick different styles. Your normal style-switch control follows this order." rect 48 112 544 20 font 4 textscale .59 forecolor .66 .78 .86 1 visible 1 decoration }
 itemDef { name slot1 text "Slot 1:" rect 64 142 528 28 type ITEM_TYPE_MULTI cvar ui_saberStyleSlot1
  cvarFloatList { "Blue" 1 "Yellow" 2 "Red" 3 "Green" 4 "Purple" 5 "Orange" 6 } font 4 textscale .87 forecolor .86 .93 1 1 visible 1 }
 itemDef { name st_hybrid_slot1_note text "" rect 64 170 528 18 font 4 textscale .57 forecolor .66 .78 .86 1 visible 1 decoration }
 itemDef { name slot1_color1 rect 48 142 3 24 style 1 backcolor .25 .65 1 .9 visible 1 decoration cvarTest ui_saberStyleSlot1 showCvar { "1" } }
