	menuDef 
	{
		name					"playerMenu"
		fullScreen				1			
		rect					0 0 640 480	
		focusColor				1 1 1 1
		descX					320
		descY					430
		descScale .8
		descColor .55 .72 .83 1
		descAlignment				ITEM_ALIGN_CENTER
	
		onOpen
		{ 
			uiScript		update  "ui_GetName" 
		}
									
		onESC 
		{ 
			play		"sound/interface/menuroam.wav"
			close		playerMenu
			open		mainMenu
		}

		onClose 
		{ 
			uiScript		update  "ui_SetName" 
		}



