			decoration
		}


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       


		itemDef 
		{
			name				addressTitle
			text				@MENUS_ENTER_IP_ADDRESS
			style				0
			decoration
			font				2
			textscale			.8
			rect				10 35 220 20
			textalign			ITEM_ALIGN_CENTER
			textalignx			110
			textaligny			3
			forecolor .30 .78 1 1
			visible				1
		}

		itemDef 
		{
			name				addressEntry
			style				1
