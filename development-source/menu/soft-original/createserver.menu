	menuDef 
	{
		name					"createserver"
		fullScreen				MENU_TRUE				
		rect					0 0 640 480				                                 
		visible					1					                   
		focusColor				1 1 1 1				                                  
		descX					320
		descY					424
		descScale .8
		descColor .55 .72 .83 1
		descAlignment				ITEM_ALIGN_CENTER		

		onEsc 
		{ 
			setcvartocvar 			password g_password 
			close				createserver
			open				multiplayermenu
			uiscript			checkservername
		}

		onOpen 
		{ 
			setcvartocvar 			password g_password
			uiScript			loadArenas
			hide				accept_alt
			show				accept
			hide				back_alt
			show				back
			hide				grpmessage
			uiScript			setBotButtons
			uiscript			clampmaxplayers
			uiscript			checkservername
		}



