// Saber Trials presentation skin; generated by Theme-Menu-Details.py
                                                                

{
	menuDef 
	{
		name				"controlsMenu"
		fullScreen			1					                
		rect				0 0 640 480				                                
		visible				0					                  
		focusColor			1 1 1 1					                                 
		descX				320
		descY					424
		descScale .8
		descColor .55 .72 .83 1
		descAlignment			ITEM_ALIGN_CENTER		

		onOpen 
		{
			uiScript 		loadControls;

			show			setup_background ;
			show 			movecontrols ;
			hide 			attackcontrols ;
			hide			weaponcontrols ;
			hide			forcecontrols ;
			hide			forcecontrols2 ;
			hide 			quickcontrols ;
			hide			joycontrols ;
			hide			othercontrols ;
			setitemcolor		movementcontrolbutton 		forecolor 1 1 1 1 ;
			setitemcolor		attackcontrolbutton 		forecolor .76 .86 .93 1 ;
			setitemcolor		weaponscontrolbutton 		forecolor .76 .86 .93 1 ;
			setitemcolor		forcecontrolbutton 		forecolor .76 .86 .93 1 ;
			setitemcolor		forcecontrolbutton2 		forecolor .76 .86 .93 1 ;		
			setitemcolor		quickcontrolbutton 		forecolor .76 .86 .93 1 ;
			setitemcolor		mousejoystickcontrolbutton 	forecolor .76 .86 .93 1 ;
			setitemcolor		othercontrolbutton 		forecolor .76 .86 .93 1 ;
		}

		onClose 
		{
			uiScript 			saveControls
		}
									
		onESC 
		{ 
			play				"sound/interface/menuroam.wav" ; 
			hide				highlights ;
			close				controlsMenu ; 
			open				main ;
		}

