			textaligny          2
			font 2
			textscale 0.65
			forecolor .30 .78 1 1
			visible             1
			decoration
		}

		itemDef
		{
			name joinTournament
			text "JOIN TOURNAMENT"
			descText "Register for the open Tournament."
			type ITEM_TYPE_BUTTON
			rect 25 52 250 30
			textalign ITEM_ALIGN_CENTER
			textalignx 125
			font 2
			textscale .8
			forecolor .76 .86 .93 1
			visible 1
			action { play "sound/interface/button1.wav" ; exec "cmd tournament join" ; }
		}

		itemDef
		{
			name leaveTournament
			text "LEAVE TOURNAMENT"
			descText "Leave while registration is still open."
			type ITEM_TYPE_BUTTON
			rect 25 88 250 30
			textalign ITEM_ALIGN_CENTER
			textalignx 125
			font 2
			textscale .8
			forecolor .76 .86 .93 1
			visible 1
			action { play "sound/interface/button1.wav" ; exec "cmd tournament leave" ; }
		}

		itemDef
		{
			name tournamentStatus
			text "VIEW STATUS / BRACKET"
			descText "Print current registration and bracket information."
			type ITEM_TYPE_BUTTON
			rect 25 124 250 30
			textalign ITEM_ALIGN_CENTER
			textalignx 125
			font 2
			textscale .8
			forecolor .76 .86 .93 1
			visible 1
			action { play "sound/interface/button1.wav" ; exec "cmd tournament status" ; exec "cmd tournament bracket" ; uiScript closeingame ; }
		}

