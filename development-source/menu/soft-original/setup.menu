// Saber Trials presentation skin; generated by Theme-Menu-Details.py
                                                                 

{

	menuDef 

	{

		name					"setup_menu"

		fullScreen				1				                 
		rect					0 0 640 480			                                 
		visible					0				                   
		focusColor				1 1 1 1				                                  
		appearanceIncrement			75				                  
		descX					320

		descY					424

		descScale .8

		descColor .55 .72 .83 1

		descAlignment				ITEM_ALIGN_CENTER		



		onOpen 

		{

			uiScript		getvideosetup			                      


			show			setup_background

			show 			video

			hide			applyChanges

			hide			video2

			hide			video3

			hide			vidrestart

			hide			sound

			hide			options

			hide			mods

			hide			defaults

			hide			highlights



			setitemcolor	setup_submenu	 forecolor .76 .86 .93 1

			setitemcolor	video1menubutton forecolor	1 1 1 1

		}

			

		onESC 

		{ 

			play				"sound/interface/button1.wav"



			defer				VideoSetup	videowarningMenu



			close				all

			open				mainMenu

		}




