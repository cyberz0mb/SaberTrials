itemDef {
name st_interface_settings
group setup_submenu
rect 80 258.135 170 27.8919
type ITEM_TYPE_BUTTON
text "UI Settings"
font 2 textscale .82 textalign ITEM_ALIGN_LEFT textalignx 12 textaligny 2
forecolor .76 .86 .93 1 visible 1
descText "Customize the HUD and character portraits."
action { play "sound/interface/button1.wav" ; open st_interface_main ; }
}
itemDef {
 name "st_editor_categoryline6"
 rect 88 341.34000000000003 154 0.4
 style 1
 backcolor .22 .49 .64 .35
 visible 1
 decoration
}
}menuDef {
name st_interface_main
rect 170 75 440 355
visible 0 fullscreen 0 style 1
backcolor .008 .026 .044 1 border 1 borderSize .5 bordercolor .22 .49 .64 .8
focusColor 1 1 1 1
onOpen { setfocus hud ; }
onESC { close st_interface_main ; }
itemDef { name "title" type 0 rect 22 17 396 22 text "UI SETTINGS" font 4 textscale 1 textalign 0 textalignx 0 textaligny 0 forecolor .30 .78 1 1 visible 1 decoration  }
itemDef { name "intro" type 0 rect 22 47 396 22 text "Choose what you want to customize." font 2 textscale 0.74 textalign 0 textalignx 0 textaligny 0 forecolor .76 .86 .93 1 visible 1 decoration  }
itemDef { name "focus_glow" rect 0 0 1 1 style 3 background "ui/assets/sabertrials/focus" forecolor 1 1 1 1 visible 0 decoration group focus }
itemDef { name "hud_panel" rect 22 87 396 67 style 1 backcolor .02 .07 .105 .8 visible 1 decoration  }
itemDef { name "hud_line" rect 22 122 396 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "hud_icon" rect 34 95.0 20 20 style 3 background "ui/assets/sabertrials/controls" forecolor 1 1 1 1 visible 1 decoration  }
itemDef { name "hud" rect 22 87 396 36 type 1 style 0 text "HUD appearance"
 font 2 textscale .85 textalignx 48 textaligny 8.0
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 22 87 396 36 ; }
 leaveFocus { hide focus_glow ; }
 action { play "sound/interface/button1.wav" ; open st_hud_main ; }  }
itemDef { name "hud_description" type 0 rect 37 127 370 22 text "Style, size, transparency and score display." font 2 textscale 0.7 textalign 0 textalignx 0 textaligny 0 forecolor .55 .72 .83 1 visible 1 decoration  }
itemDef { name "portrait_panel" rect 22 173 396 67 style 1 backcolor .02 .07 .105 .8 visible 1 decoration  }
itemDef { name "portrait_line" rect 22 208 396 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "portrait_icon" rect 34 181.0 20 20 style 3 background "ui/assets/sabertrials/player" forecolor 1 1 1 1 visible 1 decoration  }
itemDef { name "portrait" rect 22 173 396 36 type 1 style 0 text "Head portraits"
 font 2 textscale .85 textalignx 48 textaligny 8.0
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 22 173 396 36 ; }
 leaveFocus { hide focus_glow ; }
 action { play "sound/interface/button1.wav" ; open st_portrait_main ; }  }
itemDef { name "portrait_description" type 0 rect 37 213 370 22 text "Live or static heads, subject, size and reactions." font 2 textscale 0.7 textalign 0 textalignx 0 textaligny 0 forecolor .55 .72 .83 1 visible 1 decoration  }
itemDef { name "footer" rect 22 302 396 0.5 style 1 backcolor .22 .49 .64 .5 visible 1 decoration  }
itemDef { name "back_line" rect 318 342 100 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "back" rect 318 318 100 25 type 1 style 0 text "Back"
 font 2 textscale .85 textalignx 14 textaligny 2.5
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 318 318 100 25 ; }
 leaveFocus { hide focus_glow ; }
 action { play "sound/interface/button1.wav" ; close st_interface_main ; } textscale .78 }
}


