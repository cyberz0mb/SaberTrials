// Saber Trials presentation skin; generated by Theme-Menu-Details.py
                 
{
	menuDef 
	{
		name					"videowarningMenu"
		visible					0
		fullScreen				0				                
		rect					0 0 640 480
		focusColor				1 1 1 1				                                  
		outOfBoundsClick							                                                                                        
		descX					320
		descY					434
		descScale .8
		descColor .55 .72 .83 1			                                  
		descAlignment				ITEM_ALIGN_CENTER		
		popup
										
		onESC 
		{ 
			play				"sound/interface/button1.wav" ; 
			close				"videowarningMenu" ;
			setcvar				"ui_r_modified" 0 ;
			rundeferred ;
		}

		onClose
		{
			play				"sound/interface/button1.wav" ; 
		}

		itemDef {
 name "st_editor_popup"
 rect 0 0 640 480
 style 1
 backcolor .004 .014 .025 .45
 visible 1
 decoration
}
itemDef 
		{
			name				warn_background
			group				none
			style 1
			rect				100 100 440 320

			forecolor			1 1 1 1
			visible				1
			decoration
		
 backcolor .008 .026 .044 .91

 border 1

 bordersize .5

 bordercolor .22 .49 .64 .65
}


		itemDef 
		{
			name				vidwarn_title
			group				vidwarn
			style 0

			text				@MENUS_UNAPPLIED_VIDEO_CHANGES
      			rect				120 129 400 20
			font 2
			textscale 0.92
			textalign			ITEM_ALIGN_CENTER		
			textalignx			200
			textaligny			-3
			forecolor			1 1 1 1
      			visible				1 
      			decoration 
		}


		itemDef 
		{
			name				vidwarn_text1
			group				vidwarn
			text				@MENUS_YOU_HAVE_MADE_CHANGES
			rect				210 230 220 20
			textalign			ITEM_ALIGN_CENTER
			text2aligny			18
			textalignx			110
			font				2
			textscale			1        
			forecolor .76 .86 .93 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				vidwarn_text2
			group				vidwarn
			text				@MENUS_APPLY_THESE_CHANGES_OR
			rect				210 250 220 20
			textalign			ITEM_ALIGN_CENTER
			textalignx			110
			font				2
			textscale			1        
			forecolor .76 .86 .93 1
			visible				1
		}

                                                
		itemDef 
		{
			name				vidwarn_no_button
			group				vidwarn
			style				WINDOW_STYLE_SHADER
			rect				180 386 120 24 
			background "ui/assets/sabertrials/focus"
			forecolor			1 1 1 1
			decoration
			visible				0 
		}

		itemDef 
		{
			name				vidwarn_no
			group				vidwarn
			text				@MENUS_DISCARD
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				180 386 120 24 
			font				2
			textscale			1        
			textalign			ITEM_ALIGN_CENTER
			textalignx			60
			textaligny			-3
			descText			@MENUS_DO_NOT_APPLY_CHANGES
			forecolor .76 .86 .93 1
			visible				1

			action 
			{ 
				play			"sound/interface/button1.wav" ; 
				close			"videowarningMenu" ;

				setcvar			"ui_r_modified" 0 ;

				rundeferred ;
			}

			mouseEnter 
			{ 
				show		vidwarn_no_button
			}

			mouseExit 
			{ 
				hide		vidwarn_no_button
			}	  	  
		}

                              
		itemDef 
		{
			name				vidwarn_yes_button
			group				vidwarn
			style				WINDOW_STYLE_SHADER
			rect				340 386 120 24 
			background "ui/assets/sabertrials/focus"
			forecolor			1 1 1 1
			decoration
			visible				0
		}

		itemDef 
		{
			name				vidwarn_yes
			group				vidwarn
			text				@MENUS_APPLY
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				340 386 120 24 
			font				2
			textscale			1        
			textalign			ITEM_ALIGN_CENTER
			textalignx			60
			textaligny			-3
			descText			@MENUS_APPLY_CHANGES_AND_THEN
			forecolor .76 .86 .93 1
			visible				1

			action 
			{ 
				play			"sound/interface/button1.wav" ; 

				uiScript		updatevideosetup ;

                                                               
				close			all
			}
			mouseEnter 
			{ 
				show		vidwarn_yes_button
			}
			mouseExit 
			{ 
				hide		vidwarn_yes_button			
			}	  	  
		}
	
	}	
}






