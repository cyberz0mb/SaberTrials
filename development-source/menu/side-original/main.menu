menuDef { name "st_main_exit" rect 0 0 640 480 visible 0 fullscreen 0
 popup
 focusColor 1 1 1 1 disableColor .35 .42 .47 1
 onOpen { setfocus back ; } onESC { close st_main_exit ; }
itemDef { name "panel" rect 236 62 380 275 style 1 backcolor .008 .026 .044 .94 visible 1 decoration border 1 borderSize 1 bordercolor .30 .78 1 1  }
itemDef { name "heading" type 0 rect 256 80 340 22 text "EXIT SABER TRIALS" font 4 textscale 1.02 textalign 0 textalignx 0 textaligny 0 forecolor .30 .78 1 1 visible 1 decoration  }
itemDef { name "copy0" type 0 rect 256 113 340 22 text "Quit the game and return to your desktop?" font 2 textscale 0.77 textalign 0 textalignx 0 textaligny 0 forecolor .76 .86 .93 1 visible 1 decoration  }
itemDef { name "focus_glow" rect 0 0 1 1 style 3 background "ui/assets/sabertrials/focus" forecolor 1 1 1 1 visible 0 decoration group focus }
itemDef { name "confirm_line" rect 250 209 352 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "confirm" rect 250 178 352 32 type 1 style 0 text "Quit game"
 font 2 textscale .85 textalignx 14 textaligny 6.0
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 250 178 352 32 ; }
 leaveFocus { hide focus_glow ; }
 action { play "sound/interface/button1.wav" ; uiScript quit ; }  }
itemDef { name "back_line" rect 250 326 352 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "back" rect 250 299 352 28 type 1 style 0 text "Back"
