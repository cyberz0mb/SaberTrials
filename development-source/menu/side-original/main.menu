{
assetGlobalDef {
 font "ergoec" 18 smallFont "ocr_a" 18 bigFont "anewhope" 20 small2Font "arialnb" 14
 cursor "ui/assets/sabertrials/cursor" gradientBar "ui/assets/gradientbar2.tga"
 itemFocusSound "sound/interface/menuroam.wav"
 fadeClamp 1 fadeCycle 1 fadeAmount 0.1 shadowColor 0 0 0 .6
}menuDef { name "main" rect 0 0 640 480 visible 0 fullscreen 1
 focusColor 1 1 1 1 disableColor .35 .42 .47 1
 onOpen { uiScript stMenuInit ; setfocus play ; } onESC { open st_main_exit ; }
itemDef { name "arena" rect 0 0 640 480 style 3 background "ui/assets/sabertrials/arena.tga" forecolor 1 1 1 1 visible 1 decoration  }
itemDef { name "shade" rect 0 0 640 480 style 1 backcolor .005 .018 .032 .27 visible 1 decoration  }
itemDef { name "movie" rect 0 0 640 480 style 5 cinematic "video/sabertrials_menu.roq" visible 1 decoration cvarTest "st_uiMenuMovie" showCvar { "1" } }
itemDef { name "movie_shade" rect 0 0 640 480 style 1 backcolor .005 .018 .032 .18 visible 1 decoration  }
itemDef { name "hologram" rect 290 178 272 272 style 3 background "ui/assets/sabertrials/hologram" forecolor 1 1 1 1 visible 1 decoration  }
itemDef { name "rail" rect 18 165 195 272 style 3 background "ui/assets/sabertrials/rail" forecolor 1 1 1 1 visible 1 decoration  }
