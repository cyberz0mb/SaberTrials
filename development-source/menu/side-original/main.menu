itemDef { name "brand_line" rect 155 24 425 1 style 1 backcolor .22 .64 .93 .8 visible 1 decoration  }
itemDef { name "starwars" type 0 rect 135 34 460 22 text "STAR WARS" font 3 textscale 2.3 textalign 1 textalignx 230.0 textaligny 0 forecolor .85 .93 1 1 visible 1 decoration  }
