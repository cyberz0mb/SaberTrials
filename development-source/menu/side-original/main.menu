itemDef { name "focus_glow" rect 0 0 1 1 style 3 background "ui/assets/sabertrials/focus" forecolor 1 1 1 1 visible 0 decoration group focus }
itemDef { name "play_line" rect 20 223 192 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "play_icon" rect 32 191.0 20 20 style 3 background "ui/assets/sabertrials/play" forecolor 1 1 1 1 visible 1 decoration  }
itemDef { name "play" rect 20 178 192 46 type 1 style 0 text "Play"
 font 2 textscale .85 textalignx 48 textaligny 13.0
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 20 178 192 46 ; }
 leaveFocus { hide focus_glow ; }
 action { play "sound/interface/button1.wav" ; close main ; open multiplayermenu ; }  }
