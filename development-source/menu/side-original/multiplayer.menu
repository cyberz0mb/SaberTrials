 font 2 textscale .85 textalignx 48 textaligny 8.0
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 20 256 192 36 ; }
 leaveFocus { hide focus_glow ; }
 action { play "sound/interface/button1.wav" ; close multiplayermenu ; open quickgame ; }  }
itemDef { name "playdemo_button_line" rect 20 329 192 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "playdemo_button_icon" rect 32 302.0 20 20 style 3 background "ui/assets/sabertrials/camera" forecolor 1 1 1 1 visible 1 decoration  }
itemDef { name "playdemo_button" rect 20 294 192 36 type 1 style 0 text "Recordings"
 font 2 textscale .85 textalignx 48 textaligny 8.0
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 20 294 192 36 ; }
 leaveFocus { hide focus_glow ; }
 action { play "sound/interface/button1.wav" ; close multiplayermenu ; open demo ; }  }
itemDef { name "ranked_line" rect 20 367 192 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "ranked_icon" rect 32 340.0 20 20 style 3 background "ui/assets/sabertrials/rank" forecolor 1 1 1 1 visible 1 decoration  }
