itemDef { name "back_line" rect 20 447 192 0.5 style 1 backcolor .38 .64 .78 .28 visible 1 decoration  }
itemDef { name "back" rect 20 420 192 28 type 1 style 0 text "Back"
 font 2 textscale .85 textalignx 14 textaligny 4.0
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 20 420 192 28 ; }
 leaveFocus { hide focus_glow ; }
 action { play "sound/interface/button1.wav" ; close multiplayermenu ; open mainMenu ; } textscale .8 }

}
