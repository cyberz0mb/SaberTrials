itemDef { name "rules_button_icon" rect 32 378.0 20 20 style 3 background "ui/assets/sabertrials/info" forecolor 1 1 1 1 visible 1 decoration  }
itemDef { name "rules_button" rect 20 370 192 36 type 1 style 0 text "Game rules"
 font 2 textscale .85 textalignx 48 textaligny 8.0
 forecolor .76 .86 .93 1 visible 1
 onFocus { show focus_glow ; setitemrect focus_glow 20 370 192 36 ; }
 leaveFocus { hide focus_glow ; }
