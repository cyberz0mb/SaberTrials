            group input
            rect 440 70 65 26
            type ITEM_TYPE_EDITFIELD
            text ""
            font 4
            textscale .9
            forecolor .76 .86 .93 1
            visible 0
            textalign ITEM_ALIGN_LEFT
            textalignx 4
            textaligny 2
            style WINDOW_STYLE_FILLED
            backcolor .008 .026 .044 .91
            border 1
            bordercolor .22 .49 .64 .65
            cvar "st_uiYawSpeed"
            maxChars 32
            maxPaintChars 9
            descText "Type a value, including decimals. Use Backspace or Delete to edit."
            action { setcvar st_uiInputStatus "Click Apply Input to save changes." ; }
        
 bordersize .5
}

