// Saber Trials presentation skin; generated by Theme-Menu-Details.py
                                                                

{
	menuDef 
	{
		name					"ingame_setup"
		visible					0
		fullscreen				0
		outOfBoundsClick									                                                                 
		rect					45 35 570 360
		focusColor				1 1 1 1								                                 
		style					1
		border					1
		descX					305
		descY					370
		descScale .8
		descColor .55 .72 .83 1					                                 
		descAlignment				ITEM_ALIGN_CENTER		

		onOpen 
		{
			uiScript		getvideosetup				                     

			show			setup_background
			show			video
			hide			applyChanges
			hide			video2
			hide			vidrestart
			hide			sound
			hide			options
			hide			mods
			hide			defaults
				hide			streamer
				hide network
				hide input
				hide highlights
			hide			default_glow
			hide			highlight12

			setitemcolor	setup_submenu	 forecolor .76 .86 .93 1
			setitemcolor	video1menubutton forecolor	1 1 1 1
		}
			
		onESC 
		{ 
			play				"sound/interface/button1"

			defer				VideoSetup	videowarningMenu
			hide				highlights
			close				ingame_setup
		}

		itemDef 
		{
			name				background_pic
			group				none
			style 1
			rect				0 0 570 360

			forecolor			1 1 1 1
