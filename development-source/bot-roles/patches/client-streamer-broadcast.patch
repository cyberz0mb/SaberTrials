diff --git a/codemp/cgame/cg_view.c b/codemp/cgame/cg_view.c
--- a/codemp/cgame/cg_view.c
+++ b/codemp/cgame/cg_view.c
@@ -2618,3 +2618,39 @@
 	// build cg.refdef
 	inwater = CG_CalcViewValues();
+	{
+		static vec3_t stSmoothAngles;
+		static int stSmoothClient = -1;
+		static int stSmoothTime;
+		qboolean smoothFollow = st_streamerMode.integer &&
+			st_streamerCameraSmooth.integer && cg.snap &&
+			cg.snap->ps.persistant[PERS_TEAM] == TEAM_SPECTATOR &&
+			( cg.snap->ps.pm_flags & PMF_FOLLOW );
+
+		if ( smoothFollow ) {
+			int followedClient = cg.snap->ps.clientNum;
+			int elapsed = cg.time - stSmoothTime;
+
+			if ( stSmoothClient != followedClient || elapsed <= 0 || elapsed > 250 ) {
+				VectorCopy( cg.refdef.viewangles, stSmoothAngles );
+			}
+			else {
+				float blend = Com_Clamp( 0.08f, 0.5f, elapsed / 90.0f );
+				int axis;
+
+				for ( axis = 0; axis < 3; axis++ ) {
+					stSmoothAngles[axis] = AngleNormalize180( stSmoothAngles[axis] +
+						AngleNormalize180( cg.refdef.viewangles[axis] - stSmoothAngles[axis] ) * blend );
+				}
+				VectorCopy( stSmoothAngles, cg.refdef.viewangles );
+				AnglesToAxis( cg.refdef.viewangles, cg.refdef.viewaxis );
+			}
+
+			stSmoothClient = followedClient;
+			stSmoothTime = cg.time;
+		}
+		else {
+			stSmoothClient = -1;
+			stSmoothTime = cg.time;
+		}
+	}
 	CG_SetupFrustum();
