+// Compact values for the paired Saber Trials slider/text controls only.
+static void Item_SetSliderValue(itemDef_t *item, float value) {
+    qboolean stInput = !Q_stricmp(item->cvar, "st_uiYawSpeed") ||
+        !Q_stricmp(item->cvar, "st_uiMouseAccel") || !Q_stricmp(item->cvar, "st_uiPortraitSize") || !Q_stricmp(item->cvar, "st_uiHudScale") || !Q_stricmp(item->cvar, "st_uiHudOpacity");
+    if (stInput) {
+        editFieldDef_t *editDef = item->typeData.edit;
+        value = Com_Clamp(editDef->minVal, editDef->maxVal, value);
+    }
+    DC->setCVar(item->cvar, va(stInput ? "%.6g" : "%f", value));
+}
