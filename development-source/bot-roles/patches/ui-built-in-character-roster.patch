+static qboolean ST_IsBuiltInCharacterModel( const char *dirptr )
+{
+	static const char *const characterModels[] = {
+		"jawa"
+	};
+	int i;
+
+	for ( i = 0; i < ARRAY_LEN( characterModels ); i++ )
+	{
+		if ( !Q_stricmp( dirptr, characterModels[i] ) )
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+static qboolean bIsImageFile(const char* dirptr, const char* skinname)
+{
+	char imagePath[MAX_QPATH];
+
+	Com_sprintf( imagePath, sizeof( imagePath ),
+		"models/players/%s/icon_%s", dirptr, skinname );
+	if ( ST_ImageFileExists( imagePath ) )
+	{
+		return qtrue;
+	}
+
+	/* Saber Trials exposes built-in NPC actors even when Raven did not provide
+	 * an MP profile-grid icon. Vehicles and scenery are deliberately excluded. */
+	return ST_IsBuiltInCharacterModel( dirptr );
+}
+
+static void ST_BuildPlayerIconPath( const char *modelSkin, char *iconPath,
+	size_t iconPathSize )
+{
+	const char *slash = strchr( modelSkin, '/' );
+	const char *skin;
+	char model[MAX_QPATH];
+	size_t modelLength;
+
+	if ( !slash )
+	{
+		Q_strncpyz( iconPath, "gfx/mp/custom_mp_default", iconPathSize );
+		return;
+	}
+	modelLength = slash - modelSkin;
+	if ( modelLength >= sizeof( model ) )
+	{
+		modelLength = sizeof( model ) - 1;
+	}
+	memcpy( model, modelSkin, modelLength );
+	model[modelLength] = '\0';
+	skin = slash + 1;
+
+	Com_sprintf( iconPath, iconPathSize, "models/players/%s/icon_%s",
+		model, skin );
+	if ( ST_ImageFileExists( iconPath ) )
+	{
+		return;
+	}
+
+	/* Several SP-only characters, including Jawa, already ship a suitable
+	 * portrait named after their model directory. Reuse it without copying it. */
+	Com_sprintf( iconPath, iconPathSize, "models/players/%s/%s", model, model );
+	if ( ST_ImageFileExists( iconPath ) )
+	{
+		return;
+	}
+
+	Q_strncpyz( iconPath, "gfx/mp/custom_mp_default", iconPathSize );
+}
