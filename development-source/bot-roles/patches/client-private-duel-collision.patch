+static qboolean CG_IgnorePrivateDuelCollision( const entityState_t *other ) {
+	if ( !other || other->eType != ET_PLAYER ||
+		other->number < 0 || other->number >= MAX_CLIENTS ||
+		other->number == cg.predictedPlayerState.clientNum ||
+		(other->eFlags & EF_DEAD) ) {
+		return qfalse;
+	}
+
+	if ( cg.predictedPlayerState.duelInProgress ) {
+		return other->number != cg.predictedPlayerState.duelIndex;
+	}
+
+	return other->bolt1 != 0;
+}
