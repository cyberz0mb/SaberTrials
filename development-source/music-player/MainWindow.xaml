<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PlayerRoot" Background="#0B1119" TextElement.FontFamily="Inter, Segoe UI"
      TextElement.Foreground="#EDF3F6" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="Surface" Color="#121D28"/>
    <SolidColorBrush x:Key="Stroke" Color="#304451"/>
    <SolidColorBrush x:Key="Primary" Color="#EDF3F6"/>
    <SolidColorBrush x:Key="Muted" Color="#AEC0CC"/>
    <SolidColorBrush x:Key="Cyan" Color="#64D7E9"/>
    <SolidColorBrush x:Key="Gold" Color="#EAC079"/>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Primary}"/>
      <Setter Property="Background" Value="#192A37"/><Setter Property="BorderBrush" Value="#3A5363"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,5"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Cyan}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="White"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.48"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="39"/><Setter Property="Width" Value="39"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" CornerRadius="50" Background="{TemplateBinding Background}" BorderThickness="1"
                BorderBrush="{TemplateBinding BorderBrush}">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="White"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="White"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SourceTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#A9B9C7"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/><Setter Property="GroupName" Value="Source"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid Margin="2,0">
          <Border x:Name="Tab" Background="Transparent" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"/>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border x:Name="SelectedLine" Height="2" Background="{StaticResource Cyan}" VerticalAlignment="Bottom" Visibility="Hidden" Margin="12,0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#17242F"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter TargetName="Tab" Property="Background" Value="#152632"/><Setter TargetName="SelectedLine" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Cyan}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Primary}"/><Setter Property="Background" Value="#0B141E"/>
      <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/><Setter Property="SelectionBrush" Value="#346E80"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="37"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Cyan}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RowList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Primary}"/><Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Primary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="11,5"/>
        <Setter Property="MinHeight" Value="35"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#172A36"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#1A3442"/><Setter Property="Foreground" Value="{StaticResource Cyan}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Cyan}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="#101923"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#49616E" CornerRadius="3" Margin="2,1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#84A7B5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TimeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#B6CBD1"/>
      <Setter Property="FontFamily" Value="Consolas"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SeekBar" TargetType="Slider">
      <Setter Property="Height" Value="24"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" VerticalAlignment="Center" Height="14">
            <Track.DecreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{StaticResource Cyan}" Height="3" CornerRadius="1"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="10" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Width="9" Height="9" Fill="#CBF2F5"/><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Knob" Property="Visibility" Value="Hidden"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#34505B" Height="3" CornerRadius="1"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
          <Border x:Name="FocusRing" CornerRadius="4" BorderBrush="{StaticResource Cyan}" BorderThickness="1" Visibility="Hidden" IsHitTestVisible="False"/>
        </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="#263845" BorderThickness="0,0,0,1" Padding="26,13" Background="#101923">
    <DockPanel LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" AutomationProperties.Name="Saber Trials">
        <Image x:Name="BrandEmblem" Width="27" Height="27" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="BrandWordmark" Width="132" Height="19" Margin="9,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border Width="1" Height="20" Background="#3F4D56" Margin="18,0"/>
        <TextBlock Text="Music player" Foreground="#CAD5DD" FontSize="15"/>
      </StackPanel>
    </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="MainColumn" Margin="26,15,26,16" MaxWidth="1200">
      <UniformGrid x:Name="SourceTabs" Columns="4" Margin="0,0,0,15" AutomationProperties.Name="Music source"/>
      <Border ClipToBounds="True" BorderThickness="1" BorderBrush="#35515D" CornerRadius="7">
        <Grid x:Name="Hero" Height="235" ClipToBounds="True">
          <Grid.Background><LinearGradientBrush StartPoint="0,0.4" EndPoint="1,0.72"><GradientStop Color="#152B35"/><GradientStop Color="#11232F" Offset="0.56"/><GradientStop Color="#142E3B" Offset="1"/></LinearGradientBrush></Grid.Background>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ArtColumn" Width="0.74*"/></Grid.ColumnDefinitions>
          <Grid x:Name="ArtHost" Grid.Column="1" ClipToBounds="True" IsHitTestVisible="False">
            <Grid.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Transparent"/><GradientStop Color="Black" Offset="0.13"/></LinearGradientBrush></Grid.OpacityMask>
          </Grid>
          <Border x:Name="CoverFrame" Grid.Column="1" Margin="12" Padding="3" Background="#101923"
                  BorderBrush="#35515D" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="AlbumCover" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Album cover"/>
          </Border>
          <StackPanel x:Name="HeroDetails" Grid.Column="0" Margin="25,13,6,13" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Path Width="15" Height="10" Fill="{StaticResource Gold}" Stretch="Fill" Data="M0,4h2v4h-2z M4,2h2v8h-2z M8,0h2v9h-2z M12,3h2v4h-2z"/>
              <TextBlock Text="NOW PLAYING" Margin="8,0,0,0" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock x:Name="TrackTitle" FontSize="35" FontWeight="SemiBold" LineHeight="39" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TrackArtist" FontSize="14" Foreground="#B9CDD3" Margin="1,4,0,13" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="Previous" Style="{StaticResource RoundButton}" ToolTip="Previous track" AutomationProperties.Name="Previous track">
                <Path Data="M0,0H2V12H0Z M12,0V12L3,6Z" Fill="#E0ECF2" Width="12" Height="12" Stretch="Fill"/>
              </Button>
              <Button x:Name="Toggle" Style="{StaticResource RoundButton}" Margin="9,0" Width="45" Height="45" Background="#F1CB87" BorderBrush="#F7DDAE">
                <Path x:Name="ToggleGlyph" Fill="#14222B" Width="15" Height="16" Stretch="Uniform"/>
              </Button>
              <Button x:Name="Next" Style="{StaticResource RoundButton}" ToolTip="Next track" AutomationProperties.Name="Next track">
                <Path Data="M0,0L9,6L0,12Z M10,0H12V12H10Z" Fill="#E0ECF2" Width="12" Height="12" Stretch="Fill"/>
              </Button>
            </StackPanel>
            <Grid Margin="0,9,0,0" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="Elapsed" Style="{StaticResource TimeText}"/>
              <Slider Grid.Column="1" x:Name="Seek" Style="{StaticResource SeekBar}" Margin="7,0" Minimum="0" Maximum="1"
                      SmallChange="5" LargeChange="15" ToolTip="Playback position" AutomationProperties.Name="Playback position"/>
              <TextBlock Grid.Column="2" x:Name="Total" Style="{StaticResource TimeText}"/>
            </Grid>
            <Grid Margin="0,3,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="VolumeName" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
              <Slider x:Name="Volume" Grid.Column="1" Style="{StaticResource SeekBar}" Margin="7,0" Minimum="0" Maximum="100"
                      SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True" AutomationProperties.Name="Music volume"/>
              <TextBlock x:Name="VolumeValue" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TimeText}" MinWidth="32" TextAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Margin="0,20,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="Section" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="TrackCount" Foreground="{StaticResource Muted}" Margin="12,3,0,0" FontSize="12"/>
        </StackPanel>
        <Button x:Name="SourceAction" Grid.Column="1" Background="#203945" Foreground="#D2EDF0" BorderBrush="#476573"/>
      </Grid>
      <Grid x:Name="SearchRow" Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="Search" MaxLength="300" Padding="36,4,10,4"/>
          <Path IsHitTestVisible="False" Stroke="#93B0BD" StrokeThickness="1.5" Data="M11,7A4.5,4.5 0 1 1 2,7A4.5,4.5 0 1 1 11,7 M10,10L14,14" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock x:Name="SearchHint" IsHitTestVisible="False" Margin="37,0,8,0" Foreground="#94A9B8" FontSize="14"/>
        </Grid>
        <Button x:Name="SubmitSearch" Grid.Column="1" Content="Search" Margin="8,0,0,0" MinWidth="80"/>
      </Grid>
      <Border x:Name="Library" Background="{StaticResource Surface}" BorderThickness="1" BorderBrush="#2A3C49" CornerRadius="5" Padding="6">
        <Grid>
          <ListBox x:Name="Tracks" Style="{StaticResource RowList}" MaxHeight="280" AutomationProperties.Name="Local tracks">
            <ListBox.ItemTemplate><DataTemplate><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Number}" Foreground="#98ACB9" FontFamily="Consolas" FontSize="11" Margin="0,0,5,0"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
              <Button Grid.Column="2" Tag="{Binding Index}" Content="▶" ToolTip="Play this track" AutomationProperties.Name="{Binding PlayLabel}" MinHeight="24" Width="30" Padding="0" Margin="7,0,0,0" FontSize="10"/>
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyLibrary" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,16">
            <TextBlock x:Name="EmptyTitle" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyHelp" FontSize="13" Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel x:Name="Service">
        <TextBlock x:Name="SearchHandoff" FontSize="12" Foreground="{StaticResource Muted}" Margin="1,-3,0,17" TextWrapping="Wrap"/>
        <TextBlock Text="Playback session" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,7"/>
        <TextBlock x:Name="SessionPrompt" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,7" TextWrapping="Wrap"/>
        <Border Background="{StaticResource Surface}" BorderBrush="#2A3C49" BorderThickness="1" CornerRadius="5" Padding="6">
          <Grid>
            <ListBox x:Name="Sessions" Style="{StaticResource RowList}" MaxHeight="162" AutomationProperties.Name="Playback session">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" FontSize="14"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="SessionHelp" Margin="10,10" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="#293B47" BorderThickness="0,1,0,0" Background="#101923" Padding="26,8">
    <DockPanel>
      <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource Cyan}" Margin="0,0,9,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="PlayerStatus" Foreground="#B6C7D3" FontSize="12" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
  </Border>
</Grid>
