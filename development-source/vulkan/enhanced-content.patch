+void RB_AddModelRange(VBO_t *vbo, IBO_t *ibo, surfaceType_t type, int firstIndex, int indexes, int vertices)
+{
+	if (indexes == 0) return;
+	if (tess.numIndexes && (tess.vbo_model != vbo || tess.ibo_model != ibo ||
+	    tess.surfType != type || tess.multiDrawPrimitives == MAX_MULTIDRAW_PRIMITIVES)) {
+		shader_t *shader = tess.shader;
+		int fog = tess.fogNum;
+		RB_EndSurface();
+		RB_BeginSurface(shader, fog);
+	}
+	tess.vbo_model = vbo;
+	tess.ibo_model = ibo;
+	tess.surfType = type;
+	const int last = tess.multiDrawPrimitives - 1;
+	if (last >= 0 && tess.multiDrawFirstIndex[last] + tess.multiDrawNumIndexes[last] == uint32_t(firstIndex)) {
+		tess.multiDrawNumIndexes[last] += indexes;
+	} else {
+		const int slot = tess.multiDrawPrimitives++;
+		tess.multiDrawFirstIndex[slot] = firstIndex;
+		tess.multiDrawNumIndexes[slot] = indexes;
+	}
+	tess.numIndexes = indexes;
+	tess.numVertexes = vertices;
