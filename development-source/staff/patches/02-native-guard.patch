+static unsigned guardDrops[ST_GUARD_DROP_COUNT];
+
+void SV_GuardCountDrop(STGuardDrop reason) {
+	if (guardDrops[reason] < UINT32_MAX) {
+		++guardDrops[reason];
+	}
+}
+
+static void SV_GuardReportDrops(uint32_t now) {
+	static uint32_t lastReport;
+	if (now - lastReport < 5000) {
+		return;
+	}
+	lastReport = now;
+	if (guardDrops[0] || guardDrops[1] || guardDrops[2] || guardDrops[3]) {
+		char record[160];
+		Com_sprintf(record, sizeof(record),
+			"[ST-GUARD] v=1 join_rate=%u reliable_rate=%u malformed_connect=%u source_limit=%u\n",
+			guardDrops[ST_GUARD_JOIN_RATE], guardDrops[ST_GUARD_RELIABLE_RATE],
+			guardDrops[ST_GUARD_MALFORMED_CONNECT], guardDrops[ST_GUARD_SOURCE_LIMIT]);
+		fileHandle_t log = 0;
+		FS_FOpenFileByMode("guard-traffic.log", &log, FS_APPEND);
+		if (log) {
+			FS_Write(record, strlen(record), log);
+			FS_FCloseFile(log);
+		}
+		Com_Printf("%s", record);
+		Com_Memset(guardDrops, 0, sizeof(guardDrops));
+	}
+}
 cvar_t	*sv_autoWhitelist;
 
