+#include "st_format_award.h"
+typedef void (*FormatSignal)(int,int,int,int);
+static FormatSignal formatSignal;
+Q_EXPORT void ST_BindFormatAwards(FormatSignal signal) { formatSignal = signal; }
+static int AwardSide(int mode,int slot) {
+    gentity_t *ent = &g_entities[slot];
+    if (!Player(ent) || (ent->r.svFlags & SVF_BOT)) return -1;
+    int side = ent->client->sess.sessionTeam;
+    if (mode == 2) return side == TEAM_FREE ? side : -1;
+    return ST_TffaEnabled(side,G_TffaTeams()) ? side : -1;
+}
+void ST_FormatAwardBegin(int mode) {
+    if (!formatSignal) return;
+    formatSignal(0,mode,0,0);
+    for (int i=0;i<level.maxclients;i++) {
+        int side = AwardSide(mode,i);
+        if (side >= 0) formatSignal(1,mode,i,side);
+    }
+}
+void ST_FormatAwardLeave(int slot) {
+    if (formatSignal) formatSignal(2,0,slot,0);
+}
+void ST_FormatAward(int mode,int winner,int loser) {
+    if (!formatSignal) return;
+    for (int i=0;i<level.maxclients;i++) formatSignal(3,mode,i,AwardSide(mode,i));
+    formatSignal(4,mode,winner,loser);
+}
