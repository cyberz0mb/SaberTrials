+// Photo Freeze is permitted only for an actual local human and bots.
+qboolean SV_STPhotoSolo(void) {
+    if (!svs.clients || !sv_maxclients) return qfalse;
+    int humans = 0;
+    for (int i=0;i<sv_maxclients->integer;i++) {
+        client_t *cl = &svs.clients[i];
+        if (cl->state < CS_CONNECTED || cl->netchan.remoteAddress.type == NA_BOT) continue;
+        if (cl->netchan.remoteAddress.type != NA_LOOPBACK) return qfalse;
+        humans++;
+    }
+    return humans == 1 ? qtrue : qfalse;
+}
