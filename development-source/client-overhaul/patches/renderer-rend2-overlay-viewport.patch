diff --git a/codemp/rd-rend2/tr_main.cpp b/codemp/rd-rend2/tr_main.cpp
--- a/codemp/rd-rend2/tr_main.cpp
+++ b/codemp/rd-rend2/tr_main.cpp
@@ -2487,8 +2487,10 @@ void R_SetupViewParms(const trRefdef_t *refdef)
 	Com_Memset(&tr.viewParms, 0, sizeof(viewParms_t));
 	tr.viewParms.viewportX = refdef->x;
 
-	// Shoud be just refef->y but this flips the menu orientation for models, so its actually needed like this
-	if (!tr.world)
+	// HUD portraits and menu models use top-origin screen coordinates even
