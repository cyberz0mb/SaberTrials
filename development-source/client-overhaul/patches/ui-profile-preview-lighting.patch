diff --git a/codemp/ui/ui_shared.c b/codemp/ui/ui_shared.c
--- a/codemp/ui/ui_shared.c
+++ b/codemp/ui/ui_shared.c
@@ -5471,6 +5471,18 @@ void Item_Model_Paint(itemDef_t *item) {
 	VectorCopy( origin, ent.lightingOrigin );
 	ent.renderfx = RF_LIGHTING_ORIGIN | RF_NOSHADOW;
 
+#ifndef _CGAME
+	if ( item->window.name && !Q_stricmp(item->window.name, "st_profile_preview") ) {
+		// Soft camera-facing light keeps the selected outfit readable while turning.
+		// This scene belongs only to the Profile preview, not the menu background.
+		vec3_t light;
+		VectorSet(light, origin[0]-90, origin[1]-60, origin[2]+60);
+		trap->R_AddLightToScene(light, 250, 0.9f, 0.97f, 1.0f);
+		VectorSet(light, origin[0]-45, origin[1]+75, origin[2]+20);
+		trap->R_AddLightToScene(light, 180, 0.55f, 0.7f, 0.9f);
+	}
+#endif
+
 	DC->addRefEntityToScene( &ent );
 	DC->renderScene( &refdef );
 
