 fadeClamp 1 fadeCycle 1 fadeAmount 0.1 shadowColor 0 0 0 .6
}menuDef { name "main" rect 0 0 640 480 visible 0 fullscreen 1 focusColor 0 0 0 0
onOpen { uiScript stMenuInit; setfocus play; } onESC { open st_main_exit; }
