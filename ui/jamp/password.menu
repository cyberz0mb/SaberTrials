// Saber Trials presentation skin; generated by Theme-Menu-Details.py
                                                                                                 

{

	menuDef 

	{

		name					"password_popmenu"

		visible					0

		fullscreen				0

		outOfBoundsClick									                                                                  
		rect					200 150 240 180

		focusColor				1 1 1 1								                                  
		style					1

		border					1

		descX					320

		descY					312

		descScale .8

		descColor .55 .72 .83 1

		descAlignment				ITEM_ALIGN_CENTER		

		popup



		onESC 

		{ 

			play				"sound/interface/esc.wav" ; 

			close				password_popmenu

		}




		itemDef 

		{

			name				setup_background

			group				none

			style				WINDOW_STYLE_FILLED

			rect				0 0 240 180

			backcolor .008 .026 .044 .91

			forecolor			1 1 1 1

			border				1

			bordercolor .22 .49 .64 .65

			visible				1

			decoration

		
 bordersize .5
}




		itemDef 

		{

			name				passwordTitle

			text				@MENUS_ENTER_PASSWORD

			style 0



			rect				10 5 220 20

			font 2

			textscale 0.7

			textalign			ITEM_ALIGN_CENTER		

			textalignx			110

			textaligny			1

			forecolor .30 .78 1 1

	      		visible			1 

      			decoration 

		}



		itemDef 

		{

			name				passwordEntry

			style				1

			descText			@MENUS_INPUT_PASSWORD_1

			text				@MENUS_BLANK_1

			maxchars			15

			font				2

			textscale			.8

			TYPE				4

			cvar				"password" 

			rect				20 50 200 30

			textalign			ITEM_ALIGN_LEFT

			textalignx			20

			textaligny			3

			forecolor			1 1 1 1

			backcolor .008 .026 .044 .91

			visible				1

			border				1

			bordercolor .22 .49 .64 .65

			mouseenter 

			{ 

				setitemcolor	passwordEntry backcolor .008 .026 .044 .91 

			}

			mouseexit 

			{ 

				setitemcolor	passwordEntry backcolor .008 .026 .044 .91 

			}

		
 bordersize .5
}



		itemDef 

		{

			name				button_glow

			group				none

			style				WINDOW_STYLE_SHADER

			rect				0 0 0 0

			background "ui/assets/sabertrials/profile_name_glow"

			forecolor			1 1 1 1

			visible				0

			decoration

		}



		itemDef 

		{

			name				doneText

			text				@MENUS_DONE

			descText			@MENUS_FINISHED_INPUTTING_INFO

			type				1

			font 2

			textscale 0.8

			style				WINDOW_STYLE_FILLED

			rect				20 110 200 30

			textalign			ITEM_ALIGN_CENTER

			textalignx			100

			textaligny			5

			forecolor .76 .86 .93 1

			visible				1

			action 

			{ 

				play			"sound/interface/button1.wav"

				close			password_popmenu

			}

			mouseEnter 

			{ 

				show			button_glow

				setitemrect		button_glow	10 113 240 26

			}

			mouseExit 

			{ 

				hide			button_glow

			}	  	  

		}

	}

}

