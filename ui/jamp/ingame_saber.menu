			setitemcolor	typebut_dual forecolor .76 .86 .93 1

			setitemcolor	typebut_staff forecolor .76 .86 .93 1

			uiScript			getsaberhiltinfo

		}

		onClose 

		{ 

			hide				highlights

		}



                           
