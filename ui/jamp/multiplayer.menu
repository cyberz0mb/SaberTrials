menuDef { name "st_main_tournament" rect 0 0 640 480 visible 0 fullscreen 1 focusColor .25 .85 1 1 onOpen { setfocus servers ; } onESC { close st_main_tournament ; open multiplayermenu ; }
itemDef { name panel rect 10 10 620 460 style 1 backcolor .012 .029 .040 .96 visible 1 decoration }
itemDef { name brand rect 27 22 420 22 type 0 text "SABER TRIALS" font 2 textscale .96 forecolor .81 .91 .96 1 visible 1 decoration }
itemDef { name heading rect 27 57 584 22 type 0 text "TOURNAMENT" font 2 textscale .87 forecolor .81 .91 .96 1 visible 1 decoration }
itemDef { name heading2 rect 36 140 560 22 type 0 text "Join a tournament server" font 2 textscale .98 forecolor .81 .91 .96 1 visible 1 decoration }
itemDef { name step1 rect 36 196 560 22 type 0 text "Choose your host in the server browser or enter its address." font 2 textscale .76 forecolor .81 .91 .96 1 visible 1 decoration }
itemDef { name step2 rect 36 232 560 22 type 0 text "The ready room opens when you connect to a tournament." font 2 textscale .76 forecolor .81 .91 .96 1 visible 1 decoration }
itemDef { name step3 rect 36 268 560 22 type 0 text "You can return to it from the pause menu during the event." font 2 textscale .76 forecolor .81 .91 .96 1 visible 1 decoration }
itemDef { name servers rect 36 349 205 28 type 1 text "Find a server" font 2 textscale .73 textalignx 7 textaligny 4 forecolor .8 .92 1 1 style 1 backcolor .015 .055 .08 .96 border 1 bordersize .5 bordercolor .20 .65 .84 .9 visible 1  action { play "sound/interface/button1.wav" ; close st_main_tournament ; open joinserver ; } }
itemDef { name back rect 36 423 180 28 type 1 text "Back to Play" font 2 textscale .73 textalignx 7 textaligny 4 forecolor .8 .92 1 1 style 1 backcolor .015 .055 .08 .96 border 1 bordersize .5 bordercolor .20 .65 .84 .9 visible 1  action { play "sound/interface/button1.wav" ; close st_main_tournament ; open multiplayermenu ; } }
}
