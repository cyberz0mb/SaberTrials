    menuDef {
        name "st_quickmatch" rect 124 87 392 306 popup visible 0
        style WINDOW_STYLE_FILLED backcolor .008 .026 .044 .99
        border 1 bordersize .5 bordercolor .30 .64 .82 .9 focusColor .33 .84 1 1
        onOpen { uiScript QuickOpen }
        onClose { uiScript ServerRefilter }
        onEsc { close st_quickmatch }
        descX 320 descY 383 descScale .65 descColor .55 .72 .83 1 descAlignment ITEM_ALIGN_CENTER
        itemDef { name title rect 18 11 356 23 text "Quick Match" font 2 textscale .95 forecolor .30 .78 1 1 visible 1 decoration }
        itemDef {
            name game rect 18 48 352 21 text "Game mode" type ITEM_TYPE_MULTI
            cvar "ui_stMatchGame" cvarFloatList { "Any" -1 "FFA" 0 "Duel" 3 "Power Duel" 4 "Team FFA" 6 "Siege" 7 "CTF" 8 "PUG" 10 "Ladder" 11 }
            font 4 textscale .80 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name region rect 18 71 352 21 text "Region" type ITEM_TYPE_MULTI
            cvar "ui_stMatchRegion" cvarFloatList { "Worldwide" 0 "North America" 1 "South America" 2 "Europe" 3 "Russia" 4 "Asia" 5 "Australia / Oceania" 6 "Africa" 7 }
            font 4 textscale .80 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name region_rule rect 18 94 352 21 text "Region rule" type ITEM_TYPE_MULTI
            cvar "ui_stMatchRegionOnly" cvarFloatList { "Prefer (worldwide fallback)" 0 "Selected region only" 1 }
            cvarTest "ui_stMatchRegion" hideCvar { "0" }
            font 4 textscale .80 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name max_ping rect 18 117 176 21 text "Max ping (ms)" type ITEM_TYPE_NUMERICFIELD
            cvar "ui_stMatchMaxPing" maxchars 4 descText "Enter 0 for any measured ping"
            font 4 textscale .80 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name population rect 199 117 173 21 text "Min. players" type ITEM_TYPE_NUMERICFIELD
            cvar "ui_stMatchHumans" maxchars 4 descText "Minimum human players. Enter 0 for any population."
            font 4 textscale .80 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name password rect 18 140 352 21 text "Password" type ITEM_TYPE_MULTI
            cvar "ui_stMatchPassword" cvarFloatList { "Any" -1 "Open servers only" 0 "Protected servers only" 1 }
            font 4 textscale .80 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name combat rect 18 163 352 21 text "Combat" type ITEM_TYPE_MULTI
            cvar "ui_stMatchCombat" cvarFloatList { "Any" -1 "Classic" 0 "Manual" 1 }
            font 4 textscale .80 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name browser_filters rect 18 186 352 21 text "Apply these filters to browser" type ITEM_TYPE_YESNO
            cvar "ui_stMatchFilterList"
            font 4 textscale .76 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name match_message rect 18 220 356 20 cvar "ui_stMatchMessage" type ITEM_TYPE_TEXT
            font 4 textscale .73 forecolor .76 .86 .93 1 visible 1 decoration
        }
        itemDef {
            name match_details rect 18 239 356 20 cvar "ui_stMatchDetails" type ITEM_TYPE_TEXT
            font 4 textscale .73 forecolor .55 .72 .83 1 visible 1 decoration
        }
        itemDef {
            name cancel rect 18 268 68 23 text "Back" type ITEM_TYPE_BUTTON
            font 4 textscale .82 forecolor .76 .86 .93 1 visible 1 action { close st_quickmatch }
        }
        itemDef {
            name find rect 95 268 72 23 text "Find" type ITEM_TYPE_BUTTON
            font 4 textscale .82 forecolor .30 .78 1 1 visible 1 action { uiScript QuickFind }
        }
        itemDef {
            name broaden rect 177 268 195 23 text "Clear filters and search" type ITEM_TYPE_BUTTON
            cvarTest "ui_stMatchState" showCvar { "2" }
            font 4 textscale .78 forecolor .76 .86 .93 1 visible 1 action { uiScript QuickClear }
        }
        itemDef {
            name join rect 177 268 130 23 text "Join match" type ITEM_TYPE_BUTTON
            cvarTest "ui_stMatchState" showCvar { "3" }
            font 4 textscale .82 forecolor .30 .78 1 1 visible 1 action { uiScript QuickJoin }
        }
    }
    menuDef {
        name "st_directconnect" rect 124 164 392 128 popup visible 0
        style WINDOW_STYLE_FILLED backcolor .008 .026 .044 .99
        border 1 bordersize .5 bordercolor .30 .64 .82 .9 focusColor .33 .84 1 1
        onOpen { setcvar ui_stDirectMessage "" }
        onEsc { close st_directconnect }
        itemDef { name title rect 18 10 356 23 text "Direct Connect" font 2 textscale .95 forecolor .30 .78 1 1 visible 1 decoration }
        itemDef {
            name address rect 18 42 356 22 text "Address" type ITEM_TYPE_EDITFIELD
            cvar "ui_stDirectAddress" maxchars 127 maxpaintchars 43
            font 4 textscale .82 textaligny 3 forecolor .76 .86 .93 1 visible 1
        }
        itemDef {
            name error rect 18 70 356 16 cvar "ui_stDirectMessage" type ITEM_TYPE_TEXT
            font 4 textscale .68 forecolor 1 .72 .5 1 visible 1 decoration
        }
        itemDef {
            name cancel rect 18 97 76 24 text "Back" type ITEM_TYPE_BUTTON
            font 4 textscale .82 forecolor .76 .86 .93 1 visible 1 action { close st_directconnect }
        }
        itemDef {
            name connect rect 111 97 130 24 text "Connect" type ITEM_TYPE_BUTTON
            font 4 textscale .82 forecolor .30 .78 1 1 visible 1 action { uiScript ServerDirect }
        }
    }
}
