        itemDef {
            name region_column group grpTabs rect 359 114 72 20 text "Region" type ITEM_TYPE_BUTTON
            descText "Sort by region"
            font 4 textscale .72 textalignx 4 forecolor .76 .86 .93 1 visible 1
            action {
                play "sound/interface/button1.wav" ;
                uiScript ServerSort 5 ;
                setitemcolor grpTabs backcolor .06 .25 .37 .82 ;
                setitemcolor region_column backcolor .06 .25 .37 .82 ;
                setitemcolor grpTabs forecolor .76 .86 .93 1 ;
                setitemcolor region_column forecolor 1 1 1 1 ;
                setitemcolor grpColumn backcolor 0 0 0 0 ;
            }
            mouseEnter { show button_glow2 ; setitemrect button_glow2 359 112 72 23 }
            mouseExit { hide button_glow2 }
        }

