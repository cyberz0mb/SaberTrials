			style				WINDOW_STYLE_FILLED
			rect				383 399 120 24
			textalign			ITEM_ALIGN_CENTER
			textalignx			60
			textaligny			0
			forecolor .76 .86 .93 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				open			serverinfo_popmenu
			}
			mouseenter
			{
				show			button_glow
				setitemrect		button_glow	382 400 150 20
			}
			mouseexit
			{
				hide			button_glow
			}
		}

		               
